{
  "components": {
    "schemas": {
      "CapabilitiesResponse": {
        "additionalProperties": false,
        "properties": {
          "artifact_schema": {
            "$ref": "#/components/schemas/VersionRangeSchema"
          },
          "content_types": {
            "items": {
              "type": "string"
            },
            "title": "Content Types",
            "type": "array"
          },
          "features": {
            "items": {
              "$ref": "#/components/schemas/ProtocolCapability"
            },
            "title": "Features",
            "type": "array"
          },
          "limits": {
            "$ref": "#/components/schemas/ProtocolLimitsSchema"
          },
          "model_profiles": {
            "items": {
              "type": "string"
            },
            "title": "Model Profiles",
            "type": "array"
          },
          "protocol": {
            "$ref": "#/components/schemas/VersionRangeSchema"
          },
          "worker_version": {
            "title": "Worker Version",
            "type": "string"
          }
        },
        "required": [
          "worker_version",
          "protocol",
          "artifact_schema",
          "features",
          "content_types",
          "model_profiles",
          "limits"
        ],
        "title": "CapabilitiesResponse",
        "type": "object"
      },
      "CompatibilityIssue": {
        "enum": [
          "protocol_version_incompatible",
          "artifact_schema_incompatible",
          "required_capability_unavailable"
        ],
        "title": "CompatibilityIssue",
        "type": "string"
      },
      "CompatibilityRequestSchema": {
        "additionalProperties": false,
        "properties": {
          "artifact_schema": {
            "$ref": "#/components/schemas/VersionRangeSchema"
          },
          "protocol": {
            "$ref": "#/components/schemas/VersionRangeSchema"
          },
          "required_features": {
            "default": [],
            "items": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            "maxItems": 64,
            "title": "Required Features",
            "type": "array"
          }
        },
        "required": [
          "protocol",
          "artifact_schema"
        ],
        "title": "CompatibilityRequestSchema",
        "type": "object"
      },
      "CompatibilityResponse": {
        "additionalProperties": false,
        "properties": {
          "artifact_schema_version": {
            "anyOf": [
              {
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Artifact Schema Version"
          },
          "compatible": {
            "title": "Compatible",
            "type": "boolean"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/CompatibilityIssue"
            },
            "title": "Issues",
            "type": "array"
          },
          "missing_features": {
            "items": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "type": "string"
            },
            "title": "Missing Features",
            "type": "array"
          },
          "protocol_version": {
            "anyOf": [
              {
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Protocol Version"
          }
        },
        "required": [
          "compatible",
          "protocol_version",
          "artifact_schema_version",
          "missing_features",
          "issues"
        ],
        "title": "CompatibilityResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "properties": {
          "protocol_version": {
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "title": "Protocol Version",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "worker_version": {
            "title": "Worker Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "worker_version",
          "protocol_version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ProtocolCapability": {
        "enum": [
          "resumable_uploads",
          "job_snapshots",
          "bounded_event_updates",
          "progressive_transcript",
          "recording_context",
          "content_type_override",
          "correction_ledger",
          "summary_revisions",
          "evidence_linked_artifacts",
          "publication_leases",
          "atomic_vault_publication"
        ],
        "title": "ProtocolCapability",
        "type": "string"
      },
      "ProtocolLimitsSchema": {
        "additionalProperties": false,
        "properties": {
          "default_upload_chunk_size_bytes": {
            "exclusiveMinimum": 0.0,
            "title": "Default Upload Chunk Size Bytes",
            "type": "integer"
          },
          "max_recording_context_characters": {
            "exclusiveMinimum": 0.0,
            "title": "Max Recording Context Characters",
            "type": "integer"
          },
          "max_snapshot_segments": {
            "exclusiveMinimum": 0.0,
            "title": "Max Snapshot Segments",
            "type": "integer"
          },
          "max_update_events": {
            "exclusiveMinimum": 0.0,
            "title": "Max Update Events",
            "type": "integer"
          },
          "max_upload_chunk_size_bytes": {
            "exclusiveMinimum": 0.0,
            "title": "Max Upload Chunk Size Bytes",
            "type": "integer"
          },
          "max_upload_parts": {
            "exclusiveMinimum": 0.0,
            "title": "Max Upload Parts",
            "type": "integer"
          }
        },
        "required": [
          "default_upload_chunk_size_bytes",
          "max_upload_chunk_size_bytes",
          "max_upload_parts",
          "max_snapshot_segments",
          "max_update_events",
          "max_recording_context_characters"
        ],
        "title": "ProtocolLimitsSchema",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VersionRangeSchema": {
        "additionalProperties": false,
        "properties": {
          "maximum": {
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "title": "Maximum",
            "type": "string"
          },
          "minimum": {
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
            "title": "Minimum",
            "type": "string"
          }
        },
        "required": [
          "minimum",
          "maximum"
        ],
        "title": "VersionRangeSchema",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Versioned local and private-network speech processing API.",
    "title": "Speech Capture Worker API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Capabilities",
        "tags": [
          "discovery"
        ]
      }
    },
    "/v1/capabilities/negotiate": {
      "post": {
        "operationId": "negotiateCapabilities",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompatibilityRequestSchema"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompatibilityResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Negotiate",
        "tags": [
          "discovery"
        ]
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Health",
        "tags": [
          "discovery"
        ]
      }
    }
  }
}
